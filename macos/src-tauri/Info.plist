<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the app's Info.plist by Tauri at build time. -->
	<!-- Standard AES-256 via WebCrypto, used only for the user's own data:
	     exempt, so App Store Connect does not ask on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Shown only if macOS asks about the Downloads folder. Penname has no
	     Downloads entitlement; it reads and writes only files the user picks
	     in the Open and Save dialogs, which may be in Downloads. -->
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Penname opens and saves only the files you choose. For example, if you save your encrypted key file (penname-key.pnmap) to Downloads, Penname needs access to write it there and to open it again when you restore a document.</string>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Philanthropel Limited</string>
</dict>
</plist>
